#!/usr/bin/env bash
# =============================================================================
# NEBULA — lanzador único para desplegar, parar y consultar la plataforma.
#
#   NEBULA start [--production]   Despliega controller + frontend y muestra URLs
#   NEBULA stop                   Para y limpia contenedores/redes
#   NEBULA restart [--production] stop + start
#   NEBULA status                 Estado de contenedores, puertos y credenciales
#   NEBULA logs [frontend|controller|deployer]
#   NEBULA password [PASSWORD]    Fija o muestra la password de admin
#   NEBULA install                Instala este script en ~/.local/bin/NEBULA
#   NEBULA help                   Esta ayuda
#
# El script es autosuficiente: localiza el proyecto por sí solo (no depende de
# rutas absolutas codificadas), por lo que sirve tanto desde el repo como
# desde ~/.local/bin.
# =============================================================================
set -uo pipefail

# Para alinear el panel, ${#texto} debe contar caracteres y no bytes:
# si el locale no es UTF-8 se fuerza uno disponible.
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8*|*utf8*|*UTF8*) : ;;
    *)
        if locale -a 2>/dev/null | grep -qix 'C.utf8'; then
            export LC_ALL=C.UTF-8
        fi
        ;;
esac

# --- Localización del proyecto ------------------------------------------------
_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
_self_dir="$(dirname "$_self")"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nebula"
CONFIG_FILE="$CONFIG_DIR/home"

resolve_project_dir() {
    local candidate
    # 1) override explícito, 2) ruta guardada por `NEBULA install`,
    # 3) el propio repositorio (script en <repo>/scripts o <repo>).
    for candidate in "${NEBULA_HOME:-}" "$(cat "$CONFIG_FILE" 2>/dev/null)" "$_self_dir" "$(dirname "$_self_dir")"; do
        [ -n "$candidate" ] || continue
        if [ -f "$candidate/app/main.py" ] && [ -d "$candidate/nebula" ]; then
            (cd "$candidate" && pwd)
            return 0
        fi
    done
    return 1
}

PROJECT_DIR="$(resolve_project_dir)"
if [ -z "$PROJECT_DIR" ]; then
    printf "\033[1;31m[ERROR]\033[0m No se encuentra el proyecto NEBULA. Define NEBULA_HOME o ejecuta el script desde el repositorio.\n" >&2
    exit 1
fi

VENV_PY="$PROJECT_DIR/.venv/bin/python"
ENV_FILE="$PROJECT_DIR/app/.env"
PID_FILE="$PROJECT_DIR/app/deployer.pid"
LOG_FILE="$PROJECT_DIR/app/logs/deployer.log"
DATABASES_DIR="$PROJECT_DIR/app/databases"

FRONTEND_PORT="${FRONTEND_PORT:-${NEBULA_FRONTEND_PORT:-8080}}"
CONTROLLER_PORT="${CONTROLLER_PORT:-${NEBULA_CONTROLLER_PORT:-5050}}"
STATS_PORT="${STATS_PORT:-${NEBULA_STATISTICS_PORT:-8081}}"

NEBULA_USER="${NEBULA_CONTROLLER_NAME:-${USER:-nebula}}"
FRONTEND_C="${NEBULA_USER}_nebula-frontend"
CONTROLLER_C="${NEBULA_USER}_nebula-controller"

READY_TIMEOUT="${NEBULA_READY_TIMEOUT:-240}"

DEPLOYER_PID=""

# --- Salida -------------------------------------------------------------------
msg()  { printf "\033[1;36m[NEBULA]\033[0m %s\n" "$*"; }
ok()   { printf "\033[1;32m[  OK  ]\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[AVISO]\033[0m %s\n" "$*"; }
die()  { printf "\033[1;31m[ERROR]\033[0m %s\n" "$*" >&2; exit 1; }

# --- Utilidades ---------------------------------------------------------------
container_running() { docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$1"; }
container_exists()  { docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$1"; }

# Puerto real publicado por Docker (el deployer puede reasignar puertos).
published_port() {
    local container="$1" container_port="$2" port
    port="$(docker port "$container" "$container_port" 2>/dev/null | head -1 | sed 's/.*://')"
    echo "${port:-$3}"
}

http_code() {
    local code=""
    code="$(curl -sk -o /dev/null -w "%{http_code}" --max-time 5 "$1" 2>/dev/null)" || code="000"
    [ -n "$code" ] || code="000"
    printf '%s' "$code"
}

# Un servicio está listo solo si responde 2xx/3xx.
# (Un "000" significa que no hay nadie escuchando detrás del puerto.)
is_ready() {
    case "${1:-000}" in
        2*|3*) return 0 ;;
        *) return 1 ;;
    esac
}

read_env_value() {
    local key="$1" value=""
    [ -f "$ENV_FILE" ] || return 0
    value="$(grep -E "^${key}=" "$ENV_FILE" 2>/dev/null | tail -n 1 | cut -d= -f2-)"
    echo "$value"
}

# El administrador de la plataforma vive en la base de datos (users.db):
# se resuelve desde la BD y nunca desde un nombre fijado en el codigo.
platform_admin_user() {
    [ -n "$CONTROLLER_C" ] || return 0
    container_running "$CONTROLLER_C" || return 0
    docker exec "$CONTROLLER_C" python -c "
import sys
sys.path.insert(0, '/nebula')
from nebula.controller import database as db
db.user_db_file_location = '/nebula/app/databases/users.db'
admin = db.get_platform_admin()
print(admin['user'] if admin else '')
" 2>/dev/null
}

credentials() {
    local user pass
    user="$(platform_admin_user)"
    [ -n "$user" ] || user="$(read_env_value NEBULA_DEFAULT_USER)"
    pass="$(read_env_value NEBULA_DEFAULT_PASSWORD)"
    printf '%s\n%s\n' "$user" "$pass"
}

check_docker() {
    docker info >/dev/null 2>&1 || die "Docker no está corriendo. Arráncalo con: sudo systemctl start docker"
}

check_venv() {
    [ -x "$VENV_PY" ] || die "No existe el entorno virtual $VENV_PY. Ejecuta 'make install' en $PROJECT_DIR"
}

preflight() {
    check_docker
    check_venv
}

# --- Panel de URLs ------------------------------------------------------------
PANEL_INNER=58

panel_rule() {
    local i rule=""
    for i in $(seq 1 $((PANEL_INNER + 2))); do
        rule="${rule}─"
    done
    printf '%s' "$rule"
}

# panel_row <texto plano> <texto con color>  ->  alinea al ancho del panel
panel_row() {
    local plain="$1" colored="${2:-$1}" pad
    pad=$(( PANEL_INNER - ${#plain} ))
    [ "$pad" -lt 0 ] && pad=0
    printf "\033[1;36m  │\033[0m  %b%*s\033[1;36m│\033[0m\n" "$colored" "$pad" ''
}

# panel_kv <etiqueta> <valor> [color del valor]
panel_kv() {
    local label="$1" value="$2" vcolor="${3:-}" plain colored
    plain="${label} : ${value}"
    colored="${label} : ${vcolor}${value}\033[0m"
    panel_row "$plain" "$colored"
}

show_panel() {
    local fe_port ctrl_port stats_port user pass pass_msg
    fe_port="$(published_port "$FRONTEND_C" 80/tcp "$FRONTEND_PORT")"
    ctrl_port="$(published_port "$CONTROLLER_C" "${CONTROLLER_PORT}/tcp" "$CONTROLLER_PORT")"
    stats_port="$(published_port "$FRONTEND_C" 8080/tcp "$STATS_PORT")"

    user="$(credentials | head -n1)"
    pass="$(credentials | tail -n1)"
    if [ -n "$pass" ]; then
        pass_msg="$pass"
    else
        pass_msg="(generándose; revisa 'NEBULA logs')"
    fi

    echo ""
    printf "\033[1;36m  ┌%s┐\033[0m\n" "$(panel_rule)"
    panel_row "NEBULA está desplegado y operativo" "\033[1;32mNEBULA está desplegado y operativo\033[0m"
    printf "\033[1;36m  ├%s┤\033[0m\n" "$(panel_rule)"
    panel_kv "Dashboard (frontend)" "http://127.0.0.1:${fe_port}/platform" "\033[4m"
    panel_kv "Registro" "http://127.0.0.1:${fe_port}/platform/register"
    panel_kv "Controller API" "http://127.0.0.1:${ctrl_port}/resources"
    panel_kv "Estadísticas (TB)" "http://127.0.0.1:${stats_port}"
    printf "\033[1;36m  ├%s┤\033[0m\n" "$(panel_rule)"
    panel_row "Usuario  : ${user}" "\033[1;33mUsuario\033[0m  : ${user}"
    panel_row "Password : ${pass_msg}" "\033[1;33mPassword\033[0m : ${pass_msg}"
    printf "\033[1;36m  └%s┘\033[0m\n" "$(panel_rule)"
    echo ""
    msg "NEBULA stop detiene la plataforma | NEBULA status | NEBULA logs"
    echo ""
}

# --- Arranque -----------------------------------------------------------------
on_signal() {
    trap - INT TERM
    msg "Deteniendo NEBULA..."
    if [ -n "$DEPLOYER_PID" ] && kill -0 "$DEPLOYER_PID" 2>/dev/null; then
        kill -TERM "$DEPLOYER_PID" 2>/dev/null
        for _ in $(seq 1 30); do
            kill -0 "$DEPLOYER_PID" 2>/dev/null || break
            sleep 1
        done
        if kill -0 "$DEPLOYER_PID" 2>/dev/null; then
            warn "El deployer no terminó a tiempo; se fuerza la parada."
            kill -KILL "$DEPLOYER_PID" 2>/dev/null
        fi
    fi
    ok "NEBULA detenido correctamente."
    exit 0
}

wait_ready() {
    local fe_port ctrl_port deadline i
    fe_port="$FRONTEND_PORT"
    ctrl_port="$CONTROLLER_PORT"
    deadline=$(( $(date +%s) + READY_TIMEOUT ))

    while [ "$(date +%s)" -lt "$deadline" ]; do
        if [ -n "$DEPLOYER_PID" ] && ! kill -0 "$DEPLOYER_PID" 2>/dev/null; then
            return 2
        fi
        fe_port="$(published_port "$FRONTEND_C" 80/tcp "$FRONTEND_PORT")"
        ctrl_port="$(published_port "$CONTROLLER_C" "${CONTROLLER_PORT}/tcp" "$CONTROLLER_PORT")"
        local fe_code ctrl_code
        fe_code="$(http_code "http://127.0.0.1:${fe_port}/platform")"
        ctrl_code="$(http_code "http://127.0.0.1:${ctrl_port}/resources")"
        if is_ready "$fe_code" && is_ready "$ctrl_code"; then
            return 0
        fi
        sleep 2
    done
    return 1
}

cleanup_stale() {
    # Restos de despliegues anteriores incompletos (contenedores parados o
    # redes huérfanas) bloquean el arranque: se limpian antes de desplegar.
    local ids nets
    ids="$(docker ps -aq --filter "name=${NEBULA_USER}_" 2>/dev/null || true)"
    if [ -n "$ids" ]; then
        warn "Se eliminan contenedores previos de NEBULA."
        # shellcheck disable=SC2086
        docker rm -f $ids >/dev/null 2>&1 || true
    fi
    nets="$(docker network ls --format '{{.Name}}' 2>/dev/null | grep "^${NEBULA_USER}_nebula" || true)"
    if [ -n "$nets" ]; then
        # shellcheck disable=SC2086
        docker network rm $nets >/dev/null 2>&1 || true
    fi
    rm -f "$PID_FILE"
}

do_start() {
    local prod=""
    [ "${1:-}" = "--production" ] && prod="-p"

    preflight

    if container_running "$FRONTEND_C" && container_running "$CONTROLLER_C"; then
        msg "NEBULA ya estaba en ejecución."
        show_panel
        return 0
    fi

    cleanup_stale

    mkdir -p "$(dirname "$LOG_FILE")"
    cd "$PROJECT_DIR" || die "No se puede acceder a $PROJECT_DIR"

    msg "Desplegando NEBULA (controller + frontend)..."
    if [ -n "$prod" ]; then
        msg "Modo: producción (--production)"
    else
        msg "Modo: desarrollo"
    fi
    msg "La primera vez puede tardar unos minutos. Log en vivo: NEBULA logs deployer"
    echo ""

    trap on_signal INT TERM

    # El despliegue queda en SEGUNDO PLANO y en su propia sesion (setsid): ni
    # un Ctrl+C ni cerrar la terminal lo afectan. `nohup` cubre el SIGHUP, `-u`
    # evita que la salida quede en el buffer del pipe y el PID real (no el del
    # lanzador) es el que registra el propio deployer en app/deployer.pid, que
    # es el que atiende 'NEBULA stop'.
    # shellcheck disable=SC2086
    if command -v setsid >/dev/null 2>&1; then
        setsid nohup "$VENV_PY" -u app/main.py $prod >> "$LOG_FILE" 2>&1 < /dev/null &
    else
        nohup "$VENV_PY" -u app/main.py $prod >> "$LOG_FILE" 2>&1 < /dev/null &
    fi
    local launch_pid=$!

    DEPLOYER_PID=""
    for _ in $(seq 1 60); do
        if [ -f "$PID_FILE" ]; then
            DEPLOYER_PID="$(cat "$PID_FILE" 2>/dev/null)"
            [ -n "$DEPLOYER_PID" ] && break
        fi
        kill -0 "$launch_pid" 2>/dev/null || break
        sleep 0.5
    done

    if [ -z "$DEPLOYER_PID" ]; then
        warn "El deployer no llegó a registrar su PID. Últimas líneas del log:"
        tail -n 25 "$LOG_FILE" 2>/dev/null
        trap - INT TERM
        return 1
    fi

    local rc=0
    wait_ready
    rc=$?

    if [ "$rc" -eq 2 ]; then
        warn "El proceso de despliegue terminó inesperadamente. Últimas líneas del log:"
        tail -n 25 "$LOG_FILE" 2>/dev/null
        trap - INT TERM
        return 1
    fi

    if [ "$rc" -ne 0 ]; then
        warn "NEBULA no respondió en ${READY_TIMEOUT}s. Revisa 'NEBULA logs' para más detalle."
        trap - INT TERM
        return 1
    fi

    trap - INT TERM
    show_panel

    # La terminal se devuelve: NEBULA sigue desplegado en segundo plano.
    ok "NEBULA queda en segundo plano (PID $DEPLOYER_PID). Para detenerlo: NEBULA stop"
    return 0
}

# --- Parada -------------------------------------------------------------------
do_stop() {
    check_docker
    cd "$PROJECT_DIR" || die "No se puede acceder a $PROJECT_DIR"

    if [ -f "$PID_FILE" ]; then
        msg "Deteniendo el deployer de NEBULA..."
        "$VENV_PY" app/main.py --stop >/dev/null 2>&1 || true
    fi

    # Red de seguridad: elimina contenedores y redes que hayan quedado.
    local ids nets
    ids="$(docker ps -aq --filter "name=${NEBULA_USER}_" 2>/dev/null || true)"
    if [ -n "$ids" ]; then
        # shellcheck disable=SC2086
        docker rm -f $ids >/dev/null 2>&1 || true
    fi
    nets="$(docker network ls --format '{{.Name}}' 2>/dev/null | grep "^${NEBULA_USER}_nebula" || true)"
    if [ -n "$nets" ]; then
        # shellcheck disable=SC2086
        docker network rm $nets >/dev/null 2>&1 || true
    fi
    rm -f "$PID_FILE"

    ok "NEBULA detenido. Comprueba con: NEBULA status"
}

# --- Estado -------------------------------------------------------------------
do_status() {
    check_docker
    local fe_port ctrl_port user pass
    fe_port="$(published_port "$FRONTEND_C" 80/tcp "$FRONTEND_PORT")"
    ctrl_port="$(published_port "$CONTROLLER_C" "${CONTROLLER_PORT}/tcp" "$CONTROLLER_PORT")"
    user="$(credentials | head -n1)"
    pass="$(credentials | tail -n1)"

    echo "--- Contenedores ---"
    docker ps -a --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null | grep -E "NAMES|nebula" || echo "(sin contenedores nebula)"
    echo ""
    echo "--- Conectividad ---"
    printf "  Frontend   http://127.0.0.1:%s/platform        -> HTTP %s\n" "$fe_port" "$(http_code "http://127.0.0.1:${fe_port}/platform")"
    printf "  Controller http://127.0.0.1:%s/resources        -> HTTP %s\n" "$ctrl_port" "$(http_code "http://127.0.0.1:${ctrl_port}/resources")"
    echo ""
    echo "--- Credenciales ---"
    printf "  Usuario  : %s\n" "$user"
    printf "  Password : %s\n" "${pass:-(sin definir: se genera al arrancar)}"
    echo ""
    if [ -f "$PID_FILE" ]; then
        msg "Deployer activo (PID $(cat "$PID_FILE" 2>/dev/null))"
    else
        warn "No hay ningún deployer activo."
    fi
}

# --- Logs ---------------------------------------------------------------------
do_logs() {
    check_docker
    case "${1:-all}" in
        frontend|front|f) docker logs -f "$FRONTEND_C" ;;
        controller|control|c) docker logs -f "$CONTROLLER_C" ;;
        deployer|deploy|d) tail -f "$LOG_FILE" ;;
        *)
            echo "================ CONTROLLER ================"
            docker logs --tail 20 "$CONTROLLER_C" 2>&1 | tail -12
            echo ""
            echo "================ FRONTEND =================="
            docker logs --tail 20 "$FRONTEND_C" 2>&1 | tail -12
            echo ""
            echo "================ DEPLOYER =================="
            tail -n 15 "$LOG_FILE" 2>/dev/null || echo "(sin log de despliegue)"
            echo ""
            msg "Para seguir en vivo: NEBULA logs frontend | NEBULA logs controller | NEBULA logs deployer"
            ;;
    esac
}

# --- Password -----------------------------------------------------------------
do_password() {
    check_venv
    cd "$PROJECT_DIR" || die "No se puede acceder a $PROJECT_DIR"
    if [ -n "${1:-}" ]; then
        "$VENV_PY" app/main.py --set-password "$1" || die "No se pudo actualizar la password."
    else
        "$VENV_PY" app/main.py --set-password || die "No se pudieron leer las credenciales."
    fi
}

# --- Instalación --------------------------------------------------------------
do_install() {
    local target_dir="${1:-$HOME/.local/bin}"
    local target="$target_dir/NEBULA"
    mkdir -p "$target_dir"
    cp "$_self" "$target" || die "No se pudo copiar el script a $target"
    chmod +x "$target"
    # Guarda la ruta del proyecto para que el script instalado la encuentre.
    mkdir -p "$CONFIG_DIR"
    printf '%s\n' "$PROJECT_DIR" > "$CONFIG_FILE"
    ok "Instalado: $target"
    msg "Proyecto: $PROJECT_DIR (guardado en $CONFIG_FILE)"
    case ":$PATH:" in
        *":$target_dir:"*) : ;;
        *) warn "$target_dir no está en tu PATH. Añádelo: export PATH=\"\$PATH:$target_dir\"" ;;
    esac
}

# --- Ayuda --------------------------------------------------------------------
do_help() {
    cat <<EOF
NEBULA — despliegue del proyecto en una palabra

Uso:
  NEBULA                          Despliega (crea controller + frontend) y muestra las URLs
  NEBULA start [--production]    Igual que arriba; el despliegue queda en SEGUNDO PLANO
  NEBULA stop                    Para NEBULA y limpia contenedores y redes
  NEBULA restart [--production]  stop + start
  NEBULA status                  Contenedores, conectividad y credenciales
  NEBULA logs [frontend|controller|deployer]
  NEBULA password [PASSWORD]     Fija (o muestra) la password de admin
  NEBULA install [DIR]           Instala este script en ~/.local/bin/NEBULA
  NEBULA help                    Esta ayuda

URLs por defecto:
  Frontend    http://127.0.0.1:${FRONTEND_PORT}/platform
  Controller  http://127.0.0.1:${CONTROLLER_PORT}/resources
  Estadísticas http://127.0.0.1:${STATS_PORT}

Proyecto: ${PROJECT_DIR}
EOF
}

# --- Dispatch -----------------------------------------------------------------
CMD="${1:-start}"
case "$CMD" in
    start|"")        do_start "${2:-}" ;;
    stop|down|apagar) do_stop ;;
    restart|reboot)  do_stop; sleep 2; do_start "${2:-}" ;;
    status|state|ps) do_status ;;
    logs|log)        do_logs "${2:-all}" ;;
    password|pass)   do_password "${2:-}" ;;
    install)         do_install "${2:-}" ;;
    help|-h|--help)  do_help ;;
    *) die "Comando desconocido: $CMD. Usa: NEBULA help" ;;
esac
