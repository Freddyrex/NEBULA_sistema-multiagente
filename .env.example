# --- JWT (OBLIGATORIO) ---
# Genera uno con: openssl rand -hex 32
# Nunca uses el valor de ejemplo en producción (settings.py aborta si falta).
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REMEMBER_REFRESH_TOKEN_DAYS=30

# --- Base de datos (OPCIONAL) ---
# DATABASE_URL=sqlite:////absolute/path/api.db

# --- Login social con Google (OPCIONAL) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ajusta host/puerto a tu despliegue (sin TLS solo para desarrollo local):
# GOOGLE_REDIRECT_URI=https://TU_HOST/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# --- Despliegue NEBULA (puertos: fuente única nebula/config/defaults.py) ---
# NEBULA_CONTROLLER_PORT=5050
# NEBULA_FRONTEND_PORT=8080
# NEBULA_STATISTICS_PORT=8081
# NEBULA_TENSORBOARD_PORT=8082
# NEBULA_WAF_PORT=6000
# NEBULA_GRAFANA_PORT=6040
# LOKI_PORT=3100
# PHYSICAL_PORT=8000
# NEBULA_BIND_HOST=0.0.0.0
# NEBULA_TZ=Etc/UTC

# --- Admin inicial (sin defaults: obligatorio en producción) ---
# NEBULA_DEFAULT_USER=admin
# NEBULA_DEFAULT_PASSWORD=cambia-esto
# GF_SECURITY_ADMIN_PASSWORD=cambia-esto (Grafana; si vacío reutiliza el anterior)
# NEBULA_PRODUCTION=False

# --- Sesión / CORS ---
# SESSION_SECRET=genera-con-openssl-rand-hex-32 (o hereda JWT_SECRET)
# NEBULA_SESSION_COOKIE=session_8080
# Orígenes permitidos para CORS (coma-separados; vacío = solo mismo origen)
# NEBULA_CORS_ORIGINS=http://localhost:8080
# NEBULA_TENSORBOARD_HOST=127.0.0.1
# NEBULA_CONTROLLER_PUBLIC_ENDPOINT= (p. ej. mi-host.tailnet.ts.net:5050; sin default)
# Versión de estáticos para cache-busting (?v=) — súbela al cambiar JS/CSS
# NEBULA_STATIC_VERSION=20261009

# --- SMAC / Groq (fuente única: defaults.py; SMAC_TEMPERATURE bajo para JSON) ---
# GROQ_API_KEY=gsk_...
# SMAC_CHAT_MODEL=openai/gpt-oss-120b
# SMAC_TEMPERATURE=0.2
# SMAC_CHAT_MAX_TOKENS=4096
# SMAC_CHAT_REASONING_EFFORT=medium
# SMAC_TIMEOUT_S=30.0

# --- Nodos físicos / escenarios ---
# NEBULA_NODE_ENTRYPOINT=/nebula/nebula/core/node.py
# PHYSICAL_PORT=8000
# NEBULA_CONTROLLER_NAME=mi-usuario
# NEBULA_SCENARIO_IP_START=2
# NEBULA_START_DELAY_S=10
# NEBULA_LEGACY_SUBNET=192.168.50.
# NEBULA_EXTRA_HOSTS={"host.docker.internal": "host-gateway"}

# --- Imágenes Docker con registry/tag (nunca `latest` en Grafana) ---
# NEBULA_IMAGE_FRONTEND=nebula-frontend:latest
# NEBULA_IMAGE_CONTROLLER=nebula-controller:latest
# NEBULA_IMAGE_CORE=nebula-core:latest
# NEBULA_IMAGE_WAF=nebula-waf:latest
# NEBULA_IMAGE_GRAFANA=grafana/grafana:11.3.2
# NEBULA_IMAGE_LOKI=grafana/loki:3.2.0
# NEBULA_IMAGE_PROMTAIL=grafana/promtail:3.2.0
# NEBULA_IP_FRONTEND=.100
# NEBULA_IP_CONTROLLER=.150
# NEBULA_IP_WAF=.200
# NEBULA_IP_GRAFANA=.201
# NEBULA_IP_LOKI=.202
# NEBULA_IP_PROMTAIL=.203

# --- Reintentos / tiempos (ver defaults.py) ---
# NEBULA_RETRY_MAX=5
# NEBULA_RETRY_BASE_S=1.0
# NEBULA_RETRY_FACTOR=2.0
# NEBULA_RETRY_MAX_DELAY_S=30.0
# NEBULA_RETRY_JITTER=0.1
# NEBULA_FRONTEND_POLL_MS=5000
# NEBULA_MONITOR_POLL_MS=5000
# NEBULA_BREAKPOINT_DOCK=1280

# --- Térmico/energía por dispositivo (calibrar en ARM/RPi) ---
# NEBULA_CPU_TDP_W=95.0
# NEBULA_BASE_POWER_W=15.0
# NEBULA_TEMP_SEED_C=45.0
# NEBULA_TEMP_MIN_C=20.0
# NEBULA_TEMP_MAX_C=105.0

# --- Métricas / digest ---
# NEBULA_SERIES_DEFAULT_POINTS=500
# NEBULA_SERIES_HARD_CAP=2000
# NEBULA_CONVERGENCE_EPS=0.005
# NEBULA_CONVERGENCE_K=3
# NEBULA_OUTLIER_GAP=0.05
# NEBULA_OUTLIER_GAP_BY_METRIC={"accuracy": 0.05}
# NEBULA_STRAGGLER_RATIO=1.5
# NEBULA_METRICS_SCHEMA_VERSION=1.0

# --- Training / DP ---
# NEBULA_TRAIN_LOG_EVERY_N_STEPS=100
# NEBULA_DEFAULT_EPOCHS=1
# NEBULA_GPU_ASSIGNMENT_STRATEGY=round_robin

# --- Frontend opcional (Firebase/analytics; vacío = deshabilitado) ---
# NEBULA_FIREBASE_API_KEY=
# NEBULA_FIREBASE_AUTH_DOMAIN=
# NEBULA_FIREBASE_PROJECT_ID=
# NEBULA_GTAG_ID=

# --- Red Docker / controller ---
# NEBULA_CONTROLLER_SCHEME=http
# NEBULA_DOCKER_SUBNET_BASE=192.168
# NEBULA_DOCKER_SUBNET_START=50
# NEBULA_HTTP_TIMEOUT_S=15.0
# NEBULA_TAILSCALE_BIN=tailscale
# NEBULA_MULTICAST_IP=239.255.255.250
